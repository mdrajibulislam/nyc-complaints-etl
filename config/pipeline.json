{
  "_comment": [
    "Thresholds come from the data, not from guesswork. Three were changed only",
    "after the first run failed and the cause was tracked down - see README,",
    "'What the quality gate caught'."
  ],

  "sources": {
    "complaints": {
      "dataset_id": "nre2-6m2s",
      "description": "DCWP Consumer Complaints",
      "order": "record_id",
      "select": [
        "record_id",
        "business_unique_id",
        "business_name",
        "business_category",
        "complaint_code",
        "intake_channel",
        "intake_date",
        "result",
        "result_date",
        "borough",
        "postcode"
      ]
    },
    "charges": {
      "dataset_id": "5fn4-dr26",
      "description": "DCWP Charges",
      "order": "record_id",
      "select": [
        "record_id",
        "business_unique_id",
        "business_name",
        "business_category",
        "charge",
        "charge_count",
        "guilty",
        "outcome",
        "cure_eligible",
        "violation_date"
      ]
    }
  },

  "quality_rules": {
    "complaints": [
      { "check": "row_count_min", "min": 50000, "severity": "error" },
      { "_note": "134 ids repeat: one complaint, two spellings of the business name. Handled in clean_complaints; alert if it grows.",
        "check": "unique", "column": "record_id", "max_duplicates": 300, "severity": "warn" },
      { "check": "not_null", "column": "record_id", "max_null_rate": 0.0, "severity": "error" },
      { "check": "not_null", "column": "intake_date", "max_null_rate": 0.01, "severity": "error" },
      { "check": "not_null", "column": "business_unique_id", "max_null_rate": 0.05, "severity": "warn" },
      { "check": "not_null", "column": "business_category", "max_null_rate": 0.02, "severity": "warn" },
      { "check": "date_not_future", "column": "intake_date", "max_violation_rate": 0.0, "severity": "error" },
      { "check": "date_not_future", "column": "result_date", "max_violation_rate": 0.0, "severity": "warn" }
    ],
    "charges": [
      { "check": "row_count_min", "min": 100000, "severity": "error" },
      { "_note": "record_id is the adjudication CASE id; the grain is (case, charge).",
        "check": "unique_composite", "columns": ["record_id", "charge"], "max_duplicates": 20, "severity": "error" },
      { "check": "not_null", "column": "record_id", "max_null_rate": 0.0, "severity": "error" },
      { "check": "not_null", "column": "business_unique_id", "max_null_rate": 0.0, "severity": "error" },
      { "_note": "Counts above 500 are real - per-unit construction and towing violations reach 54,681. Error bound catches corruption, warn bound flags magnitude worth a look.",
        "check": "numeric_range", "column": "charge_count", "min": 0, "max": 100000, "max_violation_rate": 0.0, "severity": "error" },
      { "check": "numeric_range", "column": "charge_count", "min": 0, "max": 500, "max_violation_rate": 0.01, "severity": "warn" },
      { "check": "numeric_range", "column": "guilty", "min": 0, "max": 100000, "max_violation_rate": 0.0, "severity": "error" },
      { "check": "referential_integrity", "column": "business_unique_id", "references": "complaints.business_unique_id", "max_orphan_rate": 1.0, "severity": "warn" },
      {
        "check": "accepted_values",
        "column": "outcome",
        "values": [
          "Default Decision", "Pleaded", "Hearing Decision", "Charges Withdrawn",
          "Settlement (Pre-Hearing)", "Settlement (Post Hearing)", "Decision Dismissed"
        ],
        "max_violation_rate": 0.0,
        "severity": "warn"
      },
      { "check": "date_not_future", "column": "violation_date", "max_violation_rate": 0.0, "severity": "warn" }
    ]
  },

  "analysis": {
    "min_complaints_per_category": 100,
    "top_n": 20
  }
}
